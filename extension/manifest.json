{
  "manifest_version": 3,
  "name": "espresso",
  "version": "0.1.0",
  "description": "One click on a paper's page: build its five-minute explainer in espresso, and hand it the PDF your browser can see.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "espresso",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "browser_specific_settings": { "gecko": { "id": "espresso@espresso.local", "strict_min_version": "121.0" } }
}
