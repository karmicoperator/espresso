# Paper in Five backend. Nothing here is required: with no .env at all, the API uses a
# signed-in Claude Code session and listens on 127.0.0.1:8000.
#
#   cp .env.example .env

# Model provider. The Settings page in the app writes these lines; editing them by hand
# works too. Auto-detected when LLM_PROVIDER is unset: anthropic, openai or azure if its
# key is present, else claude_cli if the `claude` command is installed.
#   claude_cli   headless Claude Code, billed to your subscription, no key
#   anthropic    the Anthropic API, your key, official SDK
#   openai       the OpenAI API, or any OpenAI-compatible endpoint via OPENAI_BASE_URL
#   azure        Azure OpenAI
# LLM_PROVIDER=claude_cli

# claude_cli
# CLAUDE_CLI_MODEL=claude-opus-5

# anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# openai (leave OPENAI_BASE_URL empty for OpenAI itself)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=
# OPENAI_REASONING_EFFORT=low

# azure
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-5
# AZURE_OPENAI_REASONING_EFFORT=low

# Where explainers are written. Default: backend/data/explainers
# EXPLAINER_DIR=data/explainers

# Listen address. The launchers set API_PORT themselves.
# API_HOST=127.0.0.1
# API_PORT=8000

# OpenAlex asks for a contact address so it can serve the faster request pool. Only used
# when a paper turns out not to be in PubMed Central, to say whether it is open access.
# OPENALEX_CONTACT=you@example.com
