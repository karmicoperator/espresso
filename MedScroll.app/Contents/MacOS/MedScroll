#!/bin/bash
# MedScroll launcher.
#
# Installs what is missing on first run, starts the API and the web app if our own
# instances are not already up, then opens the browser. Running it twice is harmless, and
# a port held by somebody else's dev server is stepped over rather than adopted.
#
# There is no terminal here, so progress goes to notifications and failure to a dialog.
# A GUI launch that fails silently is worse than one that fails loudly.

REPO="/Users/max-j/Desktop/ScrollyTelling"

# Finder hands a GUI app a PATH of /usr/bin:/bin:/usr/sbin:/sbin. That has no node, no uv
# and no claude, so without this nothing installs and the API comes up with no model
# provider, which fails later and further from the cause.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

say()  { osascript -e "display notification \"$1\" with title \"MedScroll\"" >/dev/null 2>&1; }
fail() {
  local text=${1//\"/\\\"}
  osascript -e "display dialog \"$text\" with title \"MedScroll\" buttons {\"OK\"} default button 1 with icon stop" >/dev/null 2>&1
  exit 1
}

# If the repo moved, fall back to walking up from the bundle so the app still works when
# it is sitting inside the project.
if [ ! -d "$REPO/backend" ]; then
  HERE="$(cd "$(dirname "$0")/../../.." && pwd)"
  [ -d "$HERE/backend" ] && REPO="$HERE"
fi
[ -d "$REPO/backend" ] || fail "Cannot find the MedScroll project. It was at:

$REPO

Move the folder back, or keep MedScroll.app inside it."

cd "$REPO" || fail "Cannot open $REPO"
# shellcheck source=scripts/launch-lib.sh
. "$REPO/scripts/launch-lib.sh" || fail "scripts/launch-lib.sh is missing from $REPO"

setup_backend
setup_frontend

API=$(resolve_port api) || fail "Ports $API_PORT_BASE to $((API_PORT_BASE + PORT_SPAN)) are all in use by other programs, so the API has nowhere to listen."
WEB=$(resolve_port web) || fail "Ports $WEB_PORT_BASE to $((WEB_PORT_BASE + PORT_SPAN)) are all in use by other programs, so the web app has nowhere to listen."
API_PORT=${API%% *}; API_ACTION=${API##* }
WEB_PORT=${WEB%% *}; WEB_ACTION=$(web_action "${WEB%% *}" "${WEB##* }")
URL="http://localhost:$WEB_PORT"

# Both already ours: nothing to start, so offer the two things worth doing.
if [ "$API_ACTION" = reuse ] && [ "$WEB_ACTION" = reuse ]; then
  CHOICE=$(osascript -e "display dialog \"MedScroll is already running on port $WEB_PORT.\" with title \"MedScroll\" buttons {\"Stop\", \"Cancel\", \"Open\"} default button \"Open\"" 2>/dev/null)
  case "$CHOICE" in
    *Open*) open "$URL" ;;
    *Stop*)
      stop_port "$API_PORT"
      stop_port "$WEB_PORT"
      say "Stopped." ;;
  esac
  exit 0
fi

if [ "$API_ACTION" = start ]; then
  say "Starting the API on port $API_PORT…"
  start_api "$API_PORT"
fi

if [ "$WEB_ACTION" = start ]; then
  say "Starting the web app on port $WEB_PORT…"
  start_web "$WEB_PORT" "$API_PORT"
fi

PROVIDER=$(llm_status "$API_PORT")
ADVICE=$(llm_advice "${PROVIDER:-unconfigured}")
if [ -n "$ADVICE" ]; then
  ADVICE=${ADVICE//\"/\\\"}
  osascript -e "display dialog \"MedScroll started, but new papers cannot be built.

$ADVICE\" with title \"MedScroll\" buttons {\"Open anyway\"} default button 1 with icon caution" >/dev/null 2>&1
else
  say "Ready on port $WEB_PORT${PROVIDER:+ · $PROVIDER}"
fi
open "$URL"
